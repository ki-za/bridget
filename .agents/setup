#!/usr/bin/env bash
set -euo pipefail

readonly NODE_VERSION="22.20.0"
readonly PNPM_VERSION="10.20.0"
readonly HUGO_VERSION="0.152.2"
readonly GO_VERSION="1.21.3"
readonly REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly TOOLS_ROOT="$HOME/.local/share/bridget"
readonly NODE_ROOT="$TOOLS_ROOT/node-v$NODE_VERSION"

step() {
  printf '\n==> %s\n' "$1"
}

case "$(uname -m)" in
  x86_64)
    node_arch="x64"
    hugo_arch="linux-amd64"
    go_arch="amd64"
    ;;
  aarch64 | arm64)
    node_arch="arm64"
    hugo_arch="linux-arm64"
    go_arch="arm64"
    ;;
  *)
    printf 'Unsupported architecture: %s\n' "$(uname -m)" >&2
    exit 1
    ;;
esac

mkdir -p "$TOOLS_ROOT" "$HOME/.local/bin"

step "Installing Node.js $NODE_VERSION"
if [[ ! -x "$NODE_ROOT/bin/node" ]]; then
  archive="$(mktemp)"
  curl --fail --location --silent --show-error \
    "https://nodejs.org/dist/v$NODE_VERSION/node-v$NODE_VERSION-linux-$node_arch.tar.xz" \
    --output "$archive"
  rm -rf "$NODE_ROOT"
  mkdir -p "$NODE_ROOT"
  tar -xJf "$archive" --strip-components=1 -C "$NODE_ROOT"
  rm -f "$archive"
fi
export PATH="$NODE_ROOT/bin:$HOME/.local/bin:$PATH"

step "Installing pnpm $PNPM_VERSION"
corepack enable
corepack prepare "pnpm@$PNPM_VERSION" --activate

step "Installing Hugo Extended $HUGO_VERSION"
if [[ ! -x "$TOOLS_ROOT/hugo-$HUGO_VERSION" ]]; then
  archive="$(mktemp)"
  extract_dir="$(mktemp -d)"
  curl --fail --location --silent --show-error \
    "https://github.com/gohugoio/hugo/releases/download/v$HUGO_VERSION/hugo_extended_${HUGO_VERSION}_${hugo_arch}.tar.gz" \
    --output "$archive"
  tar -xzf "$archive" -C "$extract_dir" hugo
  install -m 0755 "$extract_dir/hugo" "$TOOLS_ROOT/hugo-$HUGO_VERSION"
  rm -rf "$archive" "$extract_dir"
fi
ln -sfn "$TOOLS_ROOT/hugo-$HUGO_VERSION" "$HOME/.local/bin/hugo"

step "Installing Go $GO_VERSION"
if [[ ! -x "$TOOLS_ROOT/go-$GO_VERSION/bin/go" ]]; then
  archive="$(mktemp)"
  extract_dir="$(mktemp -d)"
  curl --fail --location --silent --show-error \
    "https://go.dev/dl/go${GO_VERSION}.linux-${go_arch}.tar.gz" \
    --output "$archive"
  tar -xzf "$archive" -C "$extract_dir"
  rm -rf "$TOOLS_ROOT/go-$GO_VERSION"
  mv "$extract_dir/go" "$TOOLS_ROOT/go-$GO_VERSION"
  rm -rf "$archive" "$extract_dir"
fi
ln -sfn "$TOOLS_ROOT/go-$GO_VERSION/bin/go" "$HOME/.local/bin/go"
ln -sfn "$TOOLS_ROOT/go-$GO_VERSION/bin/gofmt" "$HOME/.local/bin/gofmt"

step "Persisting the repository toolchain for login shells"
profile_marker="# bridget orb toolchain"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >> "$HOME/.bash_profile" <<EOF

$profile_marker
if [[ "\${PWD}" == "$REPO_ROOT" || "\${PWD}" == "$REPO_ROOT"/* ]]; then
  export PATH="$NODE_ROOT/bin:$HOME/.local/bin:\$PATH"
fi
EOF
fi

step "Installing JavaScript dependencies"
cd "$REPO_ROOT"
pnpm install --frozen-lockfile

step "Orb setup complete"
node --version
pnpm --version
hugo version
go version
